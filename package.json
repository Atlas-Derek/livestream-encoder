{
  "name": "livestream-encoder",
  "version": "0.1.0",
  "private": true,
  "description": "ffmpeg-based live/VOD encoder that produces adaptive-bitrate HLS for nginx",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --watch src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning src/index.ts",
    "nginx": "scripts/nginx.sh",
    "test": "node --disable-warning=ExperimentalWarning --test --test-timeout=10000 \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "sample": "scripts/make-sample.sh",
    "test-media": "scripts/make-test-media.sh",
    "push:rtmp": "scripts/push-rtmp.sh",
    "push:srt": "scripts/push-srt.sh",
    "check:hls": "node --disable-warning=ExperimentalWarning src/tools/check-hls.ts",
    "e2e": "scripts/e2e.sh"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
